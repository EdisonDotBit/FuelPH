@model IReadOnlyList<FuelPH.DTOs.StationDto>

<h1 class="mb-3">FuelPH</h1>

<div class="row">
    <div class="col-md-8">
        <div id="map"></div>
    </div>

    <div class="col-md-4">
        <h4>Fuel Stations</h4>

       <div class="station-list">
            @foreach (var station in Model)
            {
                <div class="card mb-2">
                    <div class="card-body">
                        <h5 class="card-title">@station.Name</h5>

                        <p class="card-text text-muted">
                            @station.Latitude, @station.Longitude
                        </p>

                        <button class="btn btn-sm btn-primary"
                                onclick="focusStation(@station.Latitude, @station.Longitude)">
                            View on Map
                        </button>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<style>
    #map {
        height: 600px;
        width: 100%;
    }

    .station-list {
        max-height: 600px;
        overflow-y: auto;
    }
</style>

@section Scripts {
    <script>
        let map = L.map('map');

        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            attribution: '&copy; OpenStreetMap contributors'
        }).addTo(map);

        let stationLocations = [];
        let stationMarkers = [];

        @foreach (var station in Model)
        {
                <text>
                        var marker = L.marker([@station.Latitude, @station.Longitude])
                            .addTo(map)
                            .bindPopup(`
                                <strong>@station.Name</strong><br>
                                Latitude: @station.Latitude<br>
                                Longitude: @station.Longitude
                            `);
                        stationMarkers.push(marker);
                        stationLocations.push([
                            @station.Latitude,
                            @station.Longitude
                        ]);                     
                </text>
        }

        if (stationLocations.length > 0) {
            var bounds = L.latLngBounds(stationLocations);
            map.fitBounds(bounds);
        }

        function focusStation(latitude, longitude) {
            map.setView([latitude, longitude], 17);

            var marker = stationMarkers.find(function (marker) {
                let position = marker.getLatLng();

                return position.lat === latitude &&
                       position.lng === longitude;
            });

            if (marker) {
                marker.openPopup();
            }
        }
    </script>
}